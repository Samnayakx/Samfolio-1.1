{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "sambitnayak.com"
        }
      ],
      "destination": "https://www.sambitnayak.com/$1",
      "permanent": true
    },
    {
      "source": "/case-study",
      "has": [
        {
          "type": "query",
          "key": "case",
          "value": "1"
        }
      ],
      "destination": "/work/trailhead-solve",
      "permanent": true
    },
    {
      "source": "/case-study",
      "has": [
        {
          "type": "query",
          "key": "case",
          "value": "2"
        }
      ],
      "destination": "/work/cotonai-modes",
      "permanent": true
    },
    {
      "source": "/case-study",
      "has": [
        {
          "type": "query",
          "key": "case",
          "value": "3"
        }
      ],
      "destination": "/work/cotonai-design-system",
      "permanent": true
    },
    {
      "source": "/case-study",
      "has": [
        {
          "type": "query",
          "key": "case",
          "value": "4"
        }
      ],
      "destination": "/work/arcade-control-plane",
      "permanent": true
    },
    {
      "source": "/case-study",
      "has": [
        {
          "type": "query",
          "key": "case",
          "value": "5"
        }
      ],
      "destination": "/work/gap-3d-fit",
      "permanent": true
    },
    {
      "source": "/case-study",
      "has": [
        {
          "type": "query",
          "key": "case",
          "value": "6"
        }
      ],
      "destination": "/work/cotonai-agent",
      "permanent": true
    },
    {
      "source": "/case-study",
      "has": [
        {
          "type": "query",
          "key": "case",
          "value": "7"
        }
      ],
      "destination": "/work/payman-ai",
      "permanent": true
    },
    {
      "source": "/case-study",
      "destination": "/work/trailhead-solve",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(webp|jpg|jpeg|png|svg|mp4|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(js|css)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}